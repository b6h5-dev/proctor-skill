#!/usr/bin/env bash
# npm bin entry point — resolves symlinks to find the package directory,
# then dispatches to install.sh or uninstall.sh.

set -euo pipefail

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
PACKAGE_DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"

case "${1:-}" in
  uninstall)
    shift
    exec bash "$PACKAGE_DIR/uninstall.sh" "$@"
    ;;
  summary)
    shift
    exec python3 "$PACKAGE_DIR/bin/proctor-summary.py" "$@"
    ;;
  verify)
    shift
    TARGET="${1:-.}"
    FOUND=false
    if [ -f "$TARGET/.claude/settings.json" ] && grep -q "proctor.sh" "$TARGET/.claude/settings.json" 2>/dev/null; then
      echo "Claude Code: hook wired in $TARGET/.claude/settings.json"
      FOUND=true
    elif [ -f "$TARGET/.claude/hooks/proctor.sh" ]; then
      echo "Claude Code: hook script exists but NOT wired in settings.json"
    fi
    if [ -f "$TARGET/.github/hooks/proctor.json" ] && grep -q "proctor.sh" "$TARGET/.github/hooks/proctor.json" 2>/dev/null; then
      echo "Copilot: hook wired in $TARGET/.github/hooks/proctor.json"
      FOUND=true
    elif [ -f "$TARGET/.github/hooks/proctor.sh" ]; then
      echo "Copilot: hook script exists but NOT wired in proctor.json"
    fi
    if [ "$FOUND" = false ]; then
      echo "No proctor hook found in $TARGET"
      echo "  Run: npx proctor-skill $TARGET"
      echo "  Or:  npx proctor-skill --copilot $TARGET"
      exit 1
    fi
    ;;
  *)
    exec bash "$PACKAGE_DIR/install.sh" "$@"
    ;;
esac
